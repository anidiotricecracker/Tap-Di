<div class="book-detail">
  <h1>{{this.book.title}}</h1>
  <p><strong>Tác giả:</strong> {{this.book.author}}</p>
  <p><strong>Danh mục:</strong> {{this.book.category_name}}</p>
  <p><strong>Giá bán:</strong> {{this.book.price}} VNĐ</p>
  <p><strong>Số lượng còn lại:</strong> {{this.book.stock}} cuốn</p>
  <hr />
  <h3>Mô tả sách:</h3>
  <p>{{this.book.description}}</p>
  <br />
  <a href="/">← Quay lại trang chủ</a>
</div>